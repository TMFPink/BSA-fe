      "post": {
        "operationId": "bills_create",
        "description": "",
        "parameters": [
          {
            "name": "data",
            "in": "body",
            "required": true,
            "schema": {
              "required": [
                "billName",
                "category",
                "date",
                "shared",
                "billDetails",
                "participants"
              ],
              "type": "object",
              "properties": {
                "billName": {
                  "description": "billName of the bill",
                  "type": "string"
                },
                "category": {
                  "description": "Category of the bill",
                  "type": "string"
                },
                "date": {
                  "description": "Creation date of the bill",
                  "type": "date-time"
                },
                "shared": {
                  "description": "Whether the bill is shared",
                  "type": "boolean"
                },
                "billDetails": {
                  "description": "List of bill details",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "description": {
                        "description": "Name of the item",
                        "type": "string"
                      },
                      "amount": {
                        "description": "Price of the item",
                        "type": "number"
                      },
                      "user": {
                        "description": "Hashed user ID",
                        "type": "string",
                        "nullable": true
                      }
                    }
                  }
                },
                "participants": {
                  "description": "List of participants",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "description": "Hashed participant ID",
                        "type": "string"
                      },
                      "name": {
                        "description": "Name of the participant",
                        "type": "string"
                      },
                      "split_amount": {
                        "description": "Split amount for the participant",
                        "type": "number"
                      },
                      "paid": {
                        "description": "Whether the participant has paid",
                        "type": "boolean"
                      }
                    }
                  }
                },
                "payer": {
                  "description": "Payer details",
                  "type": "object",
                  "properties": {
                    "id": {
                      "description": "Hashed payer ID",
                      "type": "string"
                    },
                    "name": {
                      "description": "Name of the payer",
                      "type": "string"
                    },
                    "split_amount": {
                      "description": "Split amount for the payer",
                      "type": "number"
                    },
                    "paid": {
                      "description": "Whether the payer has paid",
                      "type": "boolean"
                    }
                  }
                },
                "allPaid": {
                  "description": "Whether all participants have paid",
                  "type": "boolean"
                }
              }
            }
          }
        ],
